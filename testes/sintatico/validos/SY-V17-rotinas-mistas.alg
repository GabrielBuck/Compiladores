algoritmo "RotinasMistas"
procedimento cabecalho
inicio
escreval("Calculadora")
fimprocedimento
funcao dobro(x: inteiro): inteiro
inicio
retorne x * 2
fimfuncao
procedimento mostrar(valor: inteiro)
inicio
escreval("Valor: ", valor)
fimprocedimento
var
n: inteiro
inicio
cabecalho
n <- dobro(21)
mostrar(n)
fimalgoritmo
